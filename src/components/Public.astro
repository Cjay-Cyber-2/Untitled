---
import { site, drops, notifications, memberBySlug } from '../data/site';
import Cursor from './Cursor.astro';
import Phone from './Phone.astro';
import Icon from './Icon.astro';
const pfColor: Record<string, string> = { youtube: 'apricot', tiktok: 'lilac', instagram: 'blush', x: 'sky', threads: 'butter', github: 'lime', linkedin: 'sky' };
const pfName: Record<string, string> = { youtube: 'YouTube', tiktok: 'TikTok', instagram: 'Instagram', x: 'X', threads: 'Threads', github: 'GitHub', linkedin: 'LinkedIn' };
const vertical = drops.filter((d) => d.vertical);
const loop = [...drops, ...drops];
---
<section class="public" id="public" data-public>
  <div class="wrap sec-head">
    <p class="eyebrow mono" style="--c:var(--lime)">05 · Building in public</p>
    <h2 class="sec-title">We film<br />everything.</h2>
    <p class="sec-sub">The wins, the bugs, the 3am deploys. Follow along while it’s still messy.</p>
    <p class="hand sec-note">yes, even the crying ↓</p>
  </div>

  <div class="pb-stage" data-stage>
    <div class="pb-phones">
      <div class="pb-ph pb-ph-l" data-side><Phone drop={vertical[0]} /></div>
      <div class="pb-ph pb-ph-c" data-main><Phone drop={vertical[vertical.length - 1]} mode="upload" /></div>
      <div class="pb-ph pb-ph-r" data-side><Phone drop={vertical[1]} /></div>
    </div>

    <ul class="pb-toasts" data-toasts aria-label="Recent activity">
      {notifications.map((n) => <li class="toast"><span class="toast-i" aria-hidden="true">{n.icon}</span><span set:html={n.text} /></li>)}
    </ul>

    <div class="pb-count" data-countbox>
      <span class="mono">Followers across platforms</span>
      <b data-count>{site.totalFollowers.toLocaleString('en-US')}</b>
      <span class="hand">and counting (please)</span>
    </div>

    <div class="cur-layer"><Cursor who="kemi" /><Cursor who="tobi" /></div>
  </div>

  <div class="wrap pb-follow" id="follow">
    <div class="pb-follow-head">
      <h3 class="pb-h3">Follow along</h3>
      <p class="sec-sub">Pick your platform. We post on all of them, mostly on time.</p>
    </div>
    <div class="pf-grid">
      {site.socials.map((s) => (
        <a class="pf" href={s.url} target="_blank" rel="noopener" style={`--c:var(--${pfColor[s.platform] ?? 'lime'})`} data-pf data-cursor={`Follow on ${pfName[s.platform]}`}>
          <span class="pf-fill" aria-hidden="true"></span>
          <span class="pf-top"><Icon name={s.platform} class="pf-icon" /><span class="mono pf-label">{s.label}</span></span>
          <span class="pf-name">{pfName[s.platform]}</span>
          <span class="pf-bottom"><span class="mono">{s.handle}</span><b>{s.followers}</b></span>
          <span class="pf-go mono">Follow <Icon name="arrow" /></span>
        </a>
      ))}
    </div>
  </div>

  <div class="pb-drops" aria-label="Latest videos">
    <div class="wrap pb-drops-head"><h3 class="pb-h3">Latest drops</h3><span class="hand">fresh out the oven</span></div>
    <div class="dr-viewport" data-marquee>
      <div class="dr-track" data-mtrack>
        {loop.map((d, i) => {
          const c = d.who === 'all' ? 'lime' : memberBySlug(d.who).color;
          return (
            <a class={`dr ${d.vertical ? 'dr-v' : 'dr-h'}`} href={d.url} target="_blank" rel="noopener" style={`--c:var(--${c})`} aria-hidden={i >= drops.length ? 'true' : undefined} tabindex={i >= drops.length ? -1 : undefined} data-cursor="Watch">
              <span class="dr-thumb">
                {d.thumb ? <img src={d.thumb} alt="" loading="lazy" /> : <span class="dr-t">{d.title}</span>}
                <span class="dr-pf"><Icon name={d.platform} /></span>
              </span>
              <span class="dr-meta"><b>{d.title}</b><span class="mono">{d.views} · {d.who === 'all' ? 'all six' : memberBySlug(d.who).first}</span></span>
            </a>
          );
        })}
      </div>
    </div>
  </div>
</section>

<style is:global>
  .pb-stage { position: relative; min-height: 100svh; display: grid; place-items: center; padding: calc(var(--bar-h) + 24px) var(--gutter) 32px; overflow: hidden; }
  .pb-phones { display: flex; align-items: center; justify-content: center; gap: clamp(16px, 3vw, 48px); width: 100%; }
  .pb-ph { width: clamp(190px, 19vw, 280px); flex: none; }
  .pb-ph-c { width: clamp(220px, 22vw, 320px); position: relative; z-index: 2; }
  .pb-ph-l { transform: rotate(-6deg) translateY(30px); }
  .pb-ph-r { transform: rotate(5deg) translateY(50px); }
  .pb-toasts { position: absolute; right: var(--gutter); top: calc(var(--bar-h) + 56px); display: grid; gap: 10px; width: min(330px, 80vw); z-index: 4; }
  .toast { display: flex; align-items: center; gap: 10px; padding: 10px 14px 10px 10px; border-radius: 16px; background: var(--paper); border: 1.5px solid var(--burgundy); box-shadow: 3px 3px 0 var(--burgundy); font-size: 14px; line-height: 1.3; }
  .toast-i { flex: none; width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; background: var(--blush); border: 1.5px solid var(--burgundy); font-size: 14px; }
  .toast:nth-child(2) .toast-i { background: var(--sky); }
  .toast:nth-child(3) .toast-i { background: var(--butter); }
  .toast:nth-child(4) .toast-i { background: var(--lime); }
  .toast b { font-weight: 700; }
  .pb-count { position: absolute; left: var(--gutter); top: calc(var(--bar-h) + 56px); display: grid; gap: 4px; z-index: 4; }
  .pb-count b { font-weight: 900; font-stretch: 125%; font-size: clamp(48px, 7vw, 112px); line-height: 0.9; font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }
  .pb-count .hand { transform: rotate(-2deg); }

  .pb-follow { padding-block: clamp(80px, 10vw, 140px) 40px; }
  .pb-follow-head { display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; margin-bottom: 32px; }
  .pb-h3 { font-weight: 800; font-stretch: 70%; font-size: clamp(44px, 6vw, 96px); line-height: 0.86; text-transform: uppercase; letter-spacing: -0.02em; }
  .pf-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .pf {
    --mx: 50%; --my: 50%;
    position: relative; isolation: isolate; overflow: hidden;
    display: grid; grid-template-rows: auto 1fr auto auto; gap: 10px; min-height: 250px;
    padding: 22px; border-radius: var(--radius); border: 1.5px solid var(--burgundy); background: var(--paper);
    transition: translate 0.35s var(--ease-out), rotate 0.35s var(--ease-out), box-shadow 0.35s var(--ease-out);
  }
  .pf:hover { translate: -3px -3px; rotate: -0.6deg; box-shadow: 6px 6px 0 var(--burgundy); }
  .pf-fill { position: absolute; inset: 0; z-index: -1; background: var(--c); clip-path: circle(0% at var(--mx) var(--my)); transition: clip-path 0.6s var(--ease-out); }
  .pf:hover .pf-fill, .pf:focus-visible .pf-fill { clip-path: circle(150% at var(--mx) var(--my)); }
  .pf-top { display: flex; justify-content: space-between; align-items: start; }
  .pf-icon { width: 34px; height: 34px; }
  .pf-label { padding: 4px 8px; border-radius: 99px; border: 1.5px solid var(--burgundy); background: var(--paper); font-size: 10px; }
  .pf-name { align-self: end; font-weight: 900; font-stretch: 120%; font-size: clamp(30px, 3.2vw, 48px); line-height: 0.9; text-transform: uppercase; letter-spacing: -0.02em; }
  .pf-bottom { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .pf-bottom b { font-weight: 800; font-size: 22px; font-variant-numeric: tabular-nums; }
  .pf-go { display: inline-flex; align-items: center; gap: 6px; justify-self: start; padding: 6px 10px; border-radius: 99px; background: var(--burgundy); color: var(--paper); }
  .pf-go svg { width: 12px; height: 12px; }

  .pb-drops { padding-block: 60px clamp(80px, 10vw, 140px); overflow: hidden; }
  .pb-drops-head { display: flex; align-items: baseline; gap: 18px; margin-bottom: 28px; }
  .dr-viewport { overflow: hidden; }
  .dr-track { display: flex; gap: 18px; width: max-content; padding: 8px 0 16px; will-change: transform; }
  .dr { flex: none; display: grid; gap: 10px; height: 340px; grid-template-rows: 1fr auto; transition: translate 0.35s var(--ease-out), rotate 0.35s var(--ease-out); }
  .dr:hover { translate: 0 -6px; rotate: -1deg; }
  .dr-v { width: 180px; }
  .dr-h { width: 430px; }
  .dr-thumb {
    position: relative; overflow: hidden; display: grid; place-items: center; padding: 18px;
    border-radius: 16px; border: 1.5px solid var(--burgundy); box-shadow: 4px 4px 0 var(--burgundy);
    background: radial-gradient(80% 60% at 25% 20%, color-mix(in srgb, var(--paper) 55%, transparent), transparent 70%), var(--c);
  }
  .dr-thumb img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .dr-t { font-weight: 900; font-stretch: 82%; font-size: 22px; line-height: 0.92; text-transform: uppercase; text-align: center; text-wrap: balance; }
  .dr-h .dr-t { font-size: 32px; }
  .dr-pf { position: absolute; left: 10px; top: 10px; width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; background: var(--paper); border: 1.5px solid var(--burgundy); }
  .dr-pf svg { width: 14px; height: 14px; }
  .dr-meta { display: grid; gap: 2px; }
  .dr-meta b { font-size: 15px; font-weight: 700; line-height: 1.2; }
  .dr-meta .mono { font-size: 10px; color: var(--wine); }

  @media (max-width: 1000px) { .pf-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 860px) {
    .pb-ph-l, .pb-ph-r { display: none; }
    .pb-ph-c { width: min(250px, 62vw); }
    .pb-toasts { top: auto; bottom: 120px; right: 50%; transform: translateX(50%); width: min(330px, 88vw); }
    .pb-toasts .toast:nth-child(n + 3) { display: none; }
    .pb-count { left: 50%; transform: translateX(-50%); top: auto; bottom: 22px; text-align: center; width: max-content; }
    .pb-count .hand { display: none; }
    .pb-count b { font-size: 44px; }
    .pf { min-height: 190px; padding: 16px; }
    .dr { height: 280px; }
    .dr-h { width: 340px; }
  }
  @media (max-width: 520px) { .pf-grid { grid-template-columns: 1fr 1fr; gap: 10px; } .pf-name { font-size: 24px; } .pf-label { display: none; } }
</style>

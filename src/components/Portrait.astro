---
import type { Member } from '../data/site';
interface Props { m: Member; class?: string; eager?: boolean }
const { m, class: cls = '', eager = false } = Astro.props;
---
<div class={`portrait ${cls}`} style={`--c:var(--${m.color})`}>
  {m.photo ? (
    <img src={m.photo} alt={`Portrait of ${m.first}`} loading={eager ? 'eager' : 'lazy'} />
  ) : (
    <>
      <span class="portrait-initial" aria-hidden="true">{m.first[0]}</span>
      <svg class="portrait-sketch" viewBox="0 0 200 250" aria-hidden="true" preserveAspectRatio="xMidYMax meet">
        <path d="M100 52c-24 0-41 19-40 44 1 22 16 42 40 43 23-1 39-20 40-43 1-25-16-44-40-44Z" />
        <path d="M63 92c-3-26 12-45 38-46 24 0 41 16 38 46" />
        <path d="M86 138c-2 9-4 15-10 19M114 138c2 9 4 15 10 19" />
        <path d="M18 252c4-46 28-80 70-90 8 9 16 12 24 0 42 10 66 44 70 90" />
        <path d="M24 250c6-40 30-70 66-82M176 250c-6-40-30-70-66-82" />
      </svg>
      <span class="ph-label">Photo · {m.slug}.jpg</span>
    </>
  )}
</div>
<style is:global>
  .portrait {
    position: relative; overflow: hidden; width: 100%; height: 100%;
    background:
      radial-gradient(120% 90% at 20% 10%, color-mix(in srgb, var(--paper) 55%, transparent), transparent 60%),
      color-mix(in srgb, var(--c) 78%, var(--paper));
  }
  .portrait img { width: 100%; height: 100%; object-fit: cover; }
  .portrait-initial {
    position: absolute; right: -0.06em; top: -0.18em;
    font-weight: 900; font-stretch: 150%; font-size: clamp(160px, 22vw, 340px); line-height: 1;
    color: color-mix(in srgb, var(--paper) 55%, transparent);
  }
  .portrait-sketch { position: absolute; left: 50%; bottom: 0; width: 82%; transform: translateX(-50%); overflow: visible; }
  .portrait-sketch path { fill: none; stroke: var(--burgundy); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; opacity: 0.75; }
</style>

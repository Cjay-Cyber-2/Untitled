---
import type { Project } from '../data/site';
interface Props { p: Project; class?: string }
const { p, class: cls = '' } = Astro.props;
---
<div class={`shot ${cls}`} style={`--c:var(--${p.color})`}>
  <div class="shot-bar" aria-hidden="true"><i></i><i></i><i></i><span>{p.slug}.app</span></div>
  <div class="shot-body">
    {p.image ? (
      <img src={p.image} alt={`Screenshot of ${p.name}`} loading="lazy" />
    ) : (
      <div class="shot-ph" aria-hidden="true">
        <div class="shot-nav"><b>{p.name}</b><span></span><span></span><span></span></div>
        <div class="shot-hero"><strong>{p.line}</strong><em></em></div>
        <div class="shot-grid"><span></span><span></span><span></span></div>
        <span class="ph-label">Screenshot · {p.slug}.png</span>
      </div>
    )}
  </div>
</div>
<style is:global>
  .shot { border: 1.5px solid var(--burgundy); border-radius: 14px; overflow: hidden; background: var(--paper); display: flex; flex-direction: column; }
  .shot-bar { display: flex; align-items: center; gap: 6px; padding: 9px 12px; border-bottom: 1.5px solid var(--burgundy); background: var(--paper); flex: none; }
  .shot-bar i { width: 9px; height: 9px; border-radius: 50%; border: 1.5px solid var(--burgundy); }
  .shot-bar i:nth-child(1) { background: var(--apricot); }
  .shot-bar i:nth-child(2) { background: var(--butter); }
  .shot-bar i:nth-child(3) { background: var(--lime); }
  .shot-bar span { margin-left: 10px; padding: 2px 10px; border-radius: 99px; background: var(--bone); font-family: var(--f-mono); font-size: 10px; }
  .shot-body { position: relative; flex: 1; min-height: 0; overflow: hidden; }
  .shot-body img { width: 100%; height: 100%; object-fit: cover; }
  .shot-ph { position: absolute; inset: 0; padding: 6% var(--ph-x, 7%); display: flex; flex-direction: column; gap: 7%; background: color-mix(in srgb, var(--c) 70%, var(--paper)); }
  .shot-nav { display: flex; align-items: center; gap: 8px; }
  .shot-nav b { font-weight: 900; font-stretch: 130%; font-size: 14px; text-transform: uppercase; margin-right: auto; }
  .shot-nav span { width: 34px; height: 6px; border-radius: 9px; background: color-mix(in srgb, var(--burgundy) 30%, transparent); }
  .shot-hero { display: grid; gap: 10px; max-width: 75%; }
  .shot-hero strong { font-weight: 800; font-stretch: 80%; font-size: clamp(16px, 2.2vw, 30px); line-height: 1; text-transform: uppercase; }
  .shot-hero em { width: 96px; height: 26px; border-radius: 99px; background: var(--burgundy); }
  .shot-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; flex: 1; min-height: 40px; }
  .shot-grid span { border-radius: 10px; background: var(--paper); border: 1.5px solid var(--burgundy); }
  .shot-grid span:nth-child(2) { background: color-mix(in srgb, var(--paper) 50%, var(--c)); }
</style>

---
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';
import Cursor from '../components/Cursor.astro';
import { site } from '../data/site';

interface Props { title?: string; description?: string; home?: boolean }
const { title = `${site.name} · six builders, building in public`, description = site.description, home = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4ece1" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        var w = sessionStorage.getItem('untitled-wipe');
        if (w) {
          document.documentElement.classList.add('wipe-in');
          document.documentElement.style.setProperty('--wipe', w);
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip sr-only" href="#main">Skip to content</a>
    <TopBar home={home} />
    <main id="main">
      <slot />
    </main>
    <div class="grain" aria-hidden="true"></div>
    <Cursor who="guest" label="You" class="guest" />
    <div class="wipe" aria-hidden="true"><span>Saving…</span></div>
  </body>
</html>
<style is:global>
  .wipe-in .wipe { transform: scaleY(1); }
  .skip:focus { position: fixed !important; left: 16px; top: 16px; width: auto; height: auto; clip: auto; z-index: 200; padding: 10px 14px; background: var(--lime); border: 1.5px solid var(--burgundy); border-radius: 8px; }
  .js [data-type]:not(.prepped) { visibility: hidden; animation: show-late 0s 2.5s forwards; }
  @keyframes show-late { to { visibility: visible; } }
</style>
